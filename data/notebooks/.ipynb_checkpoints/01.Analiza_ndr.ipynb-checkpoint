    "sql = \"\"\"\n",
    "DROP TABLE IF EXISTS dbo.network_logs;\n",
    "DROP TABLE IF EXISTS dbo.alerts;\n",
    "DROP TABLE IF EXISTS dbo.rules;\n",
    "DROP TABLE IF EXISTS dbo.sensors;\n",
    "DROP TABLE IF EXISTS dbo.scenario_labels;\n",
    "\n",
    "CREATE TABLE dbo.network_logs (\n",
    "    id INT PRIMARY KEY,\n",
    "    sensor_id INT,\n",
    "    [timestamp] DATETIME2,\n",
    "    src_ip VARCHAR(45),\n",
    "    dst_ip VARCHAR(45),\n",
    "    src_port INT,\n",
