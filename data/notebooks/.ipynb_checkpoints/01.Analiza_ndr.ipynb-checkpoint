    "    dst_port INT,\n",
    "    protocol VARCHAR(20),\n",
    "    threshold INT,\n",
    "    window_seconds INT\n",
    ");\n",
    "\n",
    "CREATE TABLE dbo.sensors (\n",
    "    id INT PRIMARY KEY,\n",
    "    name VARCHAR(100),\n",
    "    location VARCHAR(100),\n",
    "    status VARCHAR(50)\n",
    ");\n",
    "\n",
    "CREATE TABLE dbo.scenario_labels (\n",
